# Normalise line endings in the repository; files that run on Linux always check out with LF.
* text=auto
*.sh       text eol=lf
*.py       text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.service  text eol=lf
*.path     text eol=lf
*.conf     text eol=lf
*.js       text eol=lf
*.json     text eol=lf
*.ps1      text eol=crlf
*.png      binary
*.drawio   text
