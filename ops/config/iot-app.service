[Unit]
Description=Contoso operator web app (Event Grid MQTT edition)
After=network-online.target iot-certsvc.service
Wants=network-online.target

[Service]
User=iotapp
Group=iotapp
EnvironmentFile=/etc/iot/app.env
WorkingDirectory=/opt/iot/app
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
