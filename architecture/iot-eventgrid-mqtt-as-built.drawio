        </mxCell>
        <mxCell id="c-root-srv" value="" edge="1" parent="1" source="root" target="srvca" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#CA5010;strokeWidth=2.2;endArrow=block;endFill=1;startArrow=none;startFill=1;jumpStyle=arc;jumpSize=12;dashed=0;fontFamily=Segoe UI;fontSize=16;fontStyle=1;fontColor=#CA5010;labelBackgroundColor=#FFFFFF;labelBorderColor=#CA5010;spacingLeft=3;spacingRight=3;spacingTop=1;spacingBottom=1;exitX=0.75;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="660" y="325" />
              <mxPoint x="782" y="325" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c-dev-cert" value="" edge="1" parent="1" source="devca" target="devcert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#CA5010;strokeWidth=2.2;endArrow=block;endFill=1;startArrow=none;startFill=1;jumpStyle=arc;jumpSize=12;dashed=0;fontFamily=Segoe UI;fontSize=16;fontStyle=1;fontColor=#CA5010;labelBackgroundColor=#FFFFFF;labelBorderColor=#CA5010;spacingLeft=3;spacingRight=3;spacingTop=1;spacingBottom=1;exitX=0.2403;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="c-dev-gw" value="" edge="1" parent="1" source="devca" target="gwcert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#CA5010;strokeWidth=2.2;endArrow=block;endFill=1;startArrow=none;startFill=1;jumpStyle=arc;jumpSize=12;dashed=0;fontFamily=Segoe UI;fontSize=16;fontStyle=1;fontColor=#CA5010;labelBackgroundColor=#FFFFFF;labelBorderColor=#CA5010;spacingLeft=3;spacingRight=3;spacingTop=1;spacingBottom=1;exitX=0.7597;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="c-srv-mqtt" value="" edge="1" parent="1" source="srvca" target="mqttcert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#CA5010;strokeWidth=2.2;endArrow=block;endFill=1;startArrow=none;startFill=1;jumpStyle=arc;jumpSize=12;dashed=0;fontFamily=Segoe UI;fontSize=16;fontStyle=1;fontColor=#CA5010;labelBackgroundColor=#FFFFFF;labelBorderColor=#CA5010;spacingLeft=3;spacingRight=3;spacingTop=1;spacingBottom=1;exitX=0.2403;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="c-srv-enr" value="" edge="1" parent="1" source="srvca" target="enrcert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#CA5010;strokeWidth=2.2;endArrow=block;endFill=1;startArrow=none;startFill=1;jumpStyle=arc;jumpSize=12;dashed=0;fontFamily=Segoe UI;fontSize=16;fontStyle=1;fontColor=#CA5010;labelBackgroundColor=#FFFFFF;labelBorderColor=#CA5010;spacingLeft=3;spacingRight=3;spacingTop=1;spacingBottom=1;exitX=0.7597;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="life" value="DEVICE CERTIFICATE LIFECYCLE (as tested)" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#F7FAFC;strokeColor=#0078D4;strokeWidth=1.5;dashed=0;fontFamily=Segoe UI;fontSize=15;fontStyle=1;fontColor=#0078D4;align=left;verticalAlign=top;spacingLeft=16;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1060" y="120" width="1700" height="600" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1 · Register&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#5A5A5A'&gt;operator registers the device: Event Grid client with certificate authentication in its client group + one-time token (Cosmos tokens, 1-day TTL)&lt;/font&gt;" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.6;dashed=0;fontFamily=Segoe UI;fontSize=16;fontColor=#1B1B1B;align=center;verticalAlign=top;spacing=8;spacingTop=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1085" y="165" width="255" height="185" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2 · Enrol over HTTPS&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#5A5A5A'&gt;device creates its EC P-256 key and CSR&lt;br&gt;HTTPS to enroll.iot.example.com through the VPN with the one-time token&lt;br&gt;receives a 1-hour certificate&lt;/font&gt;" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.6;dashed=0;fontFamily=Segoe UI;fontSize=16;fontColor=#1B1B1B;align=center;verticalAlign=top;spacing=8;spacingTop=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1364" y="165" width="255" height="185" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3 · Connect&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#5A5A5A'&gt;mutual TLS to mqtt.iot.example.com:8883 → private endpoint&lt;br&gt;Event Grid validates the chain against iot-device-ca&lt;/font&gt;" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.6;dashed=0;fontFamily=Segoe UI;fontSize=16;fontColor=#1B1B1B;align=center;verticalAlign=top;spacing=8;spacingTop=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1643" y="165" width="255" height="185" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4 · Renew over MQTT&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#5A5A5A'&gt;at 2/3 of the lifetime (minute 40): new key + CSR on iot/cert/{site}/{id}/req&lt;br&gt;signed certificate on iot/cert/{site}/{id}/res&lt;/font&gt;" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.6;dashed=0;fontFamily=Segoe UI;fontSize=16;fontColor=#1B1B1B;align=center;verticalAlign=top;spacing=8;spacingTop=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1922" y="165" width="255" height="185" />
