        <mxCell id="e-subs-eh" value="6" edge="1" parent="1" source="subs" target="eh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078D4;strokeWidth=2.2;endArrow=block;endFill=1;startArrow=none;startFill=1;jumpStyle=arc;jumpSize=12;dashed=0;fontFamily=Segoe UI;fontSize=16;fontStyle=1;fontColor=#0078D4;labelBackgroundColor=#FFFFFF;labelBorderColor=#0078D4;spacingLeft=3;spacingRight=3;spacingTop=1;spacingBottom=1;exitX=0.0377;exitY=1.0;exitDx=0;exitDy=0;entryX=1.0;entryY=0.3333;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="2230" y="1000" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-eg-kv" value="" edge="1" parent="1" source="eg" target="kv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#CA5010;strokeWidth=2.2;endArrow=block;endFill=1;startArrow=none;startFill=1;jumpStyle=arc;jumpSize=12;dashed=1;fontFamily=Segoe UI;fontSize=16;fontStyle=1;fontColor=#CA5010;labelBackgroundColor=#FFFFFF;labelBorderColor=#CA5010;spacingLeft=3;spacingRight=3;spacingTop=1;spacingBottom=1;exitX=0.1754;exitY=1.0;exitDx=0;exitDy=0;entryX=0.1754;entryY=0.0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-cos-la" value="11" edge="1" parent="1" source="cosmos" target="la" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#605E5C;strokeWidth=2.2;endArrow=block;endFill=1;startArrow=none;startFill=1;jumpStyle=arc;jumpSize=12;dashed=1;fontFamily=Segoe UI;fontSize=16;fontStyle=1;fontColor=#605E5C;labelBackgroundColor=#FFFFFF;labelBorderColor=#605E5C;spacingLeft=3;spacingRight=3;spacingTop=1;spacingBottom=1;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-graf-la" value="" edge="1" parent="1" source="grafana" target="la" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#605E5C;strokeWidth=2.2;endArrow=block;endFill=1;startArrow=none;startFill=1;jumpStyle=arc;jumpSize=12;dashed=1;fontFamily=Segoe UI;fontSize=16;fontStyle=1;fontColor=#605E5C;labelBackgroundColor=#FFFFFF;labelBorderColor=#605E5C;spacingLeft=3;spacingRight=3;spacingTop=1;spacingBottom=1;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-alerts-la" value="" edge="1" parent="1" source="alerts" target="la" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#605E5C;strokeWidth=2.2;endArrow=block;endFill=1;startArrow=none;startFill=1;jumpStyle=arc;jumpSize=12;dashed=1;fontFamily=Segoe UI;fontSize=16;fontStyle=1;fontColor=#605E5C;labelBackgroundColor=#FFFFFF;labelBorderColor=#605E5C;spacingLeft=3;spacingRight=3;spacingTop=1;spacingBottom=1;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-it-graf" value="" edge="1" parent="1" source="itops" target="grafana" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#605E5C;strokeWidth=2.2;endArrow=block;endFill=1;startArrow=none;startFill=1;jumpStyle=arc;jumpSize=12;dashed=0;fontFamily=Segoe UI;fontSize=16;fontStyle=1;fontColor=#605E5C;labelBackgroundColor=#FFFFFF;labelBorderColor=#605E5C;spacingLeft=3;spacingRight=3;spacingTop=1;spacingBottom=1;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="flows-h" value="NUMBERED FLOWS (as tested)" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=15;fontColor=#1B1B1B;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1513" width="600" height="24" />
        </mxCell>
        <mxCell id="flows-1" value="&lt;b&gt;1&lt;/b&gt; Enrolment: the device creates its key and CSR and calls https://enroll.iot.example.com (10.40.1.10:443) through the VPN with a one-time token.&lt;br&gt;&lt;b&gt;2&lt;/b&gt; The certificate service signs with the Key Vault HSM key (iot-device-ca) through the Key Vault private endpoint.&lt;br&gt;&lt;b&gt;3&lt;/b&gt; The device connects with mutual TLS to mqtt.iot.example.com:8883 → CNAME → private endpoint 10.40.2.4.&lt;br&gt;&lt;b&gt;4&lt;/b&gt; Telemetry publish over the same MQTT session." style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=14;fontColor=#1B1B1B;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1541" width="880" height="135" />
        </mxCell>
        <mxCell id="flows-2" value="&lt;b&gt;5&lt;/b&gt; Live data to the operator app over MQTT (Entra ID JWT, OAUTH2-JWT) using the namespace default hostname through the private endpoint.&lt;br&gt;&lt;b&gt;6&lt;/b&gt; Routing: every MQTT message → namespace topic mqtt-routed (site, profile, client) → es-telemetry and es-alerts → Event Hubs.&lt;br&gt;&lt;b&gt;7&lt;/b&gt; The app's Kafka consumer (SASL OAUTHBEARER, Entra ID) reads both topics and writes history to Cosmos DB.&lt;br&gt;&lt;b&gt;8&lt;/b&gt; Commands: MQTT 5 request/response between the app and the device." style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=14;fontColor=#1B1B1B;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="960" y="1541" width="880" height="135" />
        </mxCell>
        <mxCell id="flows-3" value="&lt;b&gt;9&lt;/b&gt; Renewal over MQTT at minute 40: iot/cert/{site}/{id}/req → signed certificate on iot/cert/{site}/{id}/res.&lt;br&gt;&lt;b&gt;10&lt;/b&gt; Operators: HTTPS to Front Door (basic auth) → HTTP 80 to pip-ops; nsg-app allows only AzureFrontDoor.Backend and nginx checks X-Azure-FDID.&lt;br&gt;&lt;b&gt;11&lt;/b&gt; Diagnostic settings → Log Analytics → Grafana dashboards and alert rules → action group e-mail." style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=14;fontColor=#1B1B1B;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1880" y="1541" width="880" height="135" />
        </mxCell>
        <mxCell id="foot1" value="As built and tested · 4 November 2026 · v1.1 replaces the v1.0 target design. Devices and apps reach PaaS services only through private endpoints; the namespace's public access is limited to a placeholder documentation address (192.0.2.1/32)." style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fontColor=#5A5A5A;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1690" width="2720" height="44" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="iot-asbuilt-2" name="02 - Certificates, identities and DNS (as built)">
    <mxGraphModel grid="0" page="1" pageWidth="2800" pageHeight="1260" background="#FFFFFF" shadow="0" math="0" arrows="1" connect="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Contoso Mining | Event Grid MQTT broker demo — certificates, identities and DNS (as built)" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=30;fontColor=#1B1B1B;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="2720" height="40" />
        </mxCell>
        <mxCell id="sub" value="Contoso runs its own CA in Key Vault Premium (HSM) · 1-hour device certificates renewed over MQTT · least-privilege managed identities · split-horizon DNS over the VPN · deployed and tested" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=17;fontColor=#5A5A5A;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="66" width="2720" height="30" />
        </mxCell>
        <mxCell id="pki" value="CA HIERARCHY · keys in Key Vault Premium HSM (kv-iotmq-xxxxx), never exported" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#F7FAFC;strokeColor=#CA5010;strokeWidth=1.5;dashed=0;fontFamily=Segoe UI;fontSize=15;fontStyle=1;fontColor=#CA5010;align=left;verticalAlign=top;spacingLeft=16;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="120" width="1000" height="600" />
        </mxCell>
        <mxCell id="root" value="&lt;b&gt;iot-root-ca · RSA-HSM 3072&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px' color='#5A5A5A'&gt;key DISABLED = offline root&lt;br&gt;signs only the two issuing CAs&lt;/font&gt;" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.6;dashed=0;fontFamily=Segoe UI;fontSize=16;fontColor=#1B1B1B;align=center;verticalAlign=top;spacing=8;shape=label;image=img/lib/azure2/security/Key_Vaults.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;spacingTop=48;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="300" y="165" width="480" height="130" />
        </mxCell>
        <mxCell id="devca" value="&lt;b&gt;iot-device-ca · RSA-HSM 2048&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px' color='#5A5A5A'&gt;issuing CA for devices and gateways&lt;br&gt;uploaded to Event Grid as CA certificate&lt;/font&gt;" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.6;dashed=0;fontFamily=Segoe UI;fontSize=16;fontColor=#1B1B1B;align=center;verticalAlign=top;spacing=8;shape=label;image=img/lib/azure2/security/Key_Vaults.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;spacingTop=48;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="355" width="466" height="140" />
        </mxCell>
        <mxCell id="srvca" value="&lt;b&gt;iot-server-ca · RSA-HSM 2048&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px' color='#5A5A5A'&gt;name-constrained to iot.example.com&lt;br&gt;signs TLS server certificates only&lt;/font&gt;" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.6;dashed=0;fontFamily=Segoe UI;fontSize=16;fontColor=#1B1B1B;align=center;verticalAlign=top;spacing=8;shape=label;image=img/lib/azure2/security/Key_Vaults.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;spacingTop=48;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="549" y="355" width="466" height="140" />
        </mxCell>
        <mxCell id="devcert" value="&lt;b&gt;Device certificates&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#5A5A5A'&gt;1 hour · EC P-256 keys&lt;br&gt;Raspberry Pi · ESP32&lt;/font&gt;" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.6;dashed=1;fontFamily=Segoe UI;fontSize=15;fontColor=#1B1B1B;align=center;verticalAlign=top;spacing=8;spacingTop=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="545" width="224" height="120" />
        </mxCell>
        <mxCell id="gwcert" value="&lt;b&gt;Gateway certificate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#5A5A5A'&gt;gw-site1 · 1 hour&lt;br&gt;own key on the site agent&lt;/font&gt;" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.6;dashed=1;fontFamily=Segoe UI;fontSize=15;fontColor=#1B1B1B;align=center;verticalAlign=top;spacing=8;spacingTop=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="307" y="545" width="224" height="120" />
        </mxCell>
        <mxCell id="mqttcert" value="&lt;b&gt;MQTT server certificate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#5A5A5A'&gt;mqtt-srv-&amp;lt;timestamp&amp;gt;&lt;br&gt;7 days · rotated on day 4 under a new Key Vault name&lt;/font&gt;" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.6;dashed=1;fontFamily=Segoe UI;fontSize=15;fontColor=#1B1B1B;align=center;verticalAlign=top;spacing=8;spacingTop=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="549" y="545" width="224" height="120" />
        </mxCell>
        <mxCell id="enrcert" value="&lt;b&gt;Enrolment TLS certificate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#5A5A5A'&gt;enroll.iot.example.com&lt;br&gt;7 days&lt;/font&gt;" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.6;dashed=1;fontFamily=Segoe UI;fontSize=15;fontColor=#1B1B1B;align=center;verticalAlign=top;spacing=8;spacingTop=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="791" y="545" width="224" height="120" />
        </mxCell>
        <mxCell id="pki-note" value="The three CA certificates are stored as Key Vault secrets. Root key disabled after signing = offline root." style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fontColor=#1B1B1B;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="678" width="950" height="30" />
        </mxCell>
        <mxCell id="c-root-dev" value="" edge="1" parent="1" source="root" target="devca" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#CA5010;strokeWidth=2.2;endArrow=block;endFill=1;startArrow=none;startFill=1;jumpStyle=arc;jumpSize=12;dashed=0;fontFamily=Segoe UI;fontSize=16;fontStyle=1;fontColor=#CA5010;labelBackgroundColor=#FFFFFF;labelBorderColor=#CA5010;spacingLeft=3;spacingRight=3;spacingTop=1;spacingBottom=1;exitX=0.25;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;">
